{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": ".",
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		// Type-level assertions are intentionally unreferenced bindings.
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	// The base config excludes "test", and `exclude` is inherited through
	// `extends` and filters `include` - so it must be overridden here or this
	// suite silently checks nothing.
	"exclude": ["node_modules", "dist", "dist-test"],
	"include": ["src/**/*", "test/types.test.ts"]
}
